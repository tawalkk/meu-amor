{
  "name": "nosso-amor",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo romântico para comemorar nossa história",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "android:add": "npm run prepare:web && cap add android",
    "android:sync": "npm run prepare:web -- --android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
